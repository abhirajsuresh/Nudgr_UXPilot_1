<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_on_primary">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <solid android:color="@android:color/white"/>
        </shape>
    </item>
    <item>
        <!-- Your gradient base -->
        <inset android:insetLeft="0dp" android:insetTop="0dp" android:insetRight="0dp" android:insetBottom="0dp">
            <shape android:shape="rectangle">
                <corners android:radius="16dp"/>
                <gradient
                    android:type="linear"
                    android:startColor="@color/primary_accent_start"
                    android:endColor="@color/primary_accent_end"
                    android:angle="45"/>
            </shape>
        </inset>
    </item>
</ripple>
