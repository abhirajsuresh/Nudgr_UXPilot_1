<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- App-wide dark theme, using Android base theme -->
    <style name="Theme.Nudgr" parent="android:Theme.Material.NoActionBar">
        <!-- Edge-to-edge bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Use dark icons? false because we have a dark background -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">false</item>

        <!-- Cutout support for edge-to-edge on devices with notches -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>

        <!-- Disable force-dark to preserve your brand colors -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- Brand colors -->
        <item name="android:windowBackground">@color/dark_bg</item>

        <!-- Global typography defaults (from your Inter setup) -->
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <!-- Fullscreen "Reminder" screen variant -->
    <style name="Theme.Nudgr.Reminder" parent="Theme.Nudgr">
        <!-- Solid dark background (no translucency) -->
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsTranslucent">false</item>

        <!-- Keep bars edge-to-edge and dark icons off -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">false</item>
    </style>

</resources>
