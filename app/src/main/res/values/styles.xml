<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Root text appearance style -->
    <style name="TextAppearance.Nudgr" parent="android:TextAppearance" />

    <!-- Global button text appearance -->
    <style name="TextAppearance.Nudgr.Button">
        <item name="android:fontFamily">@font/inter_24pt_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Root button style -->
    <style name="NudgrButton" />

    <!-- Base button style (no Material3 dependency) -->
    <style name="NudgrButton.Base">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/inter_24pt_semibold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Primary button: gradient background + white text -->
    <style name="NudgrButton.Primary" parent="NudgrButton.Base">
        <item name="android:background">@drawable/btn_accent_gradient</item>
        <item name="android:textColor">@color/btn_primary_text</item>
    </style>

    <!-- Secondary Light button: light fill, dark text -->
    <style name="NudgrButton.Secondary.Light" parent="NudgrButton.Base">
        <item name="android:background">@drawable/btn_secondary_light_bg</item>
        <item name="android:textColor">@color/btn_secondary_light_text</item>
    </style>

    <!-- Secondary Dark button: transparent bg, gray stroke, white text -->
    <style name="NudgrButton.Secondary.Dark" parent="NudgrButton.Base">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/btn_secondary_dark_text</item>
    </style>

</resources>
