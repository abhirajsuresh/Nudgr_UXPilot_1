<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboard_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_accent_gradient"
                    android:padding="8dp"
                    android:src="@drawable/ic_home" />

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_marginStart="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="NUDGR"
                        android:textSize="18sp"
                        android:textColor="@android:color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:text="Dashboard"
                        android:textSize="12sp"
                        android:textColor="@color/gray_400" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_profile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_card_neutral"
                android:src="@drawable/ic_user_placeholder"
                android:scaleType="centerInside"
                android:tint="@color/gray_400" />
        </LinearLayout>

        <!-- System Status Banner -->
        <LinearLayout
            android:id="@+id/system_status_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_card_success"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_check_circle" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp">

                <TextView
                    android:text="System Ready"
                    android:textColor="@color/success"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:text="Foreground service active • Battery optimized • Overlay enabled"
                    android:textColor="@color/gray_300"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_check_circle" />
        </LinearLayout>

        <!-- Session Card -->
        <LinearLayout
            android:id="@+id/session_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_margin="16dp"
            android:background="@drawable/bg_card_neutral">

            <!-- Header row -->
            <LinearLayout
                android:id="@+id/session_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|space_between">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="Current Session"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">

                        <View
                            android:id="@+id/session_status_dot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_circle_muted" />

                        <TextView
                            android:id="@+id/session_status"
                            android:text="OFF"
                            android:textColor="@color/gray_400"
                            android:layout_marginStart="8dp"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/session_timer"
                        android:text="00:00"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:text="Duration"
                        android:textColor="@color/gray_400"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Summary line -->
            <LinearLayout
                android:id="@+id/session_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_blur"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:text="Interval"
                        android:textColor="@color/gray_400"
                        android:textSize="11sp"
                        android:allCaps="true" />

                    <TextView
                        android:id="@+id/tv_interval_value"
                        android:text="5 minutes"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:text="Images"
                        android:textColor="@color/gray_400"
                        android:textSize="11sp"
                        android:allCaps="true" />

                    <TextView
                        android:id="@+id/tv_images_value"
                        android:text="12 loaded"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Controls -->
            <Button
                android:id="@+id/btn_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="START SESSION"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:drawableLeft="@drawable/ic_session_play"
                android:drawablePadding="8dp"
                android:background="@drawable/btn_accent_gradient"
                android:layout_marginTop="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:weightSum="2">

                <Button
                    android:id="@+id/btn_pause_resume"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="PAUSE"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:drawableLeft="@drawable/ic_session_pause"
                    android:drawablePadding="8dp"
                    android:background="@drawable/bg_session_paused"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp" />

                <Button
                    android:id="@+id/btn_end"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="END"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:drawableLeft="@drawable/ic_session_stop"
                    android:drawablePadding="8dp"
                    android:background="@drawable/btn_lock_danger"
                    android:layout_marginStart="8dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Image Pool (Manage) -->
        <LinearLayout
            android:id="@+id/image_pool_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_card_neutral"
            android:padding="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_muted"
                android:padding="8dp"
                android:src="@drawable/ic_images"
                android:tint="@color/primary_accent" />

            <LinearLayout
                android:layout_marginStart="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:text="Image Library"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_images_count"
                    android:text="12 motivational images"
                    android:textColor="@color/gray_400"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_manage_images"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MANAGE"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:background="@drawable/btn_accent_gradient"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <!-- Last Session Summary -->
        <LinearLayout
            android:id="@+id/last_session_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_card_neutral"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|space_between">

                <TextView
                    android:text="Last Session"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_view_report"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIEW REPORT"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_accent"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:weightSum="3">

                <!-- Duration -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/last_duration"
                        android:text="45m"
                        android:textColor="@color/success"
                        android:textStyle="bold"
                        android:textSize="20sp" />

                    <TextView
                        android:text="Duration"
                        android:textColor="@color/gray_400"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Unlocks -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/last_unlocks"
                        android:text="8"
                        android:textColor="@color/warning"
                        android:textStyle="bold"
                        android:textSize="20sp" />

                    <TextView
                        android:text="Unlocks"
                        android:textColor="@color/gray_400"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Nudges -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/last_nudges"
                        android:text="12"
                        android:textColor="@color/secondary_accent"
                        android:textStyle="bold"
                        android:textSize="20sp" />

                    <TextView
                        android:text="Nudges"
                        android:textColor="@color/gray_400"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Actions -->
        <LinearLayout
            android:id="@+id/quick_links_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical">

            <TextView
                android:text="Quick Actions"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Timer Settings -->
                <LinearLayout
                    android:id="@+id/btn_timers"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_neutral"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_done"
                        android:padding="8dp"
                        android:src="@drawable/ic_session_pause"
                        android:tint="@color/secondary_accent" />

                    <TextView
                        android:text="Timer Settings"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:text="Configure intervals"
                        android:textColor="@color/gray_400"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Permissions -->
                <LinearLayout
                    android:id="@+id/btn_permissions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_neutral"
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_done"
                        android:padding="8dp"
                        android:src="@drawable/ic_shield"
                        android:tint="@color/primary_accent" />

                    <TextView
                        android:text="Permissions"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:text="Check access"
                        android:textColor="@color/gray_400"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Start Prerequisites -->
        <LinearLayout
            android:id="@+id/prerequisites_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="vertical">

            <TextView
                android:text="Start Prerequisites"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <!-- Granted rows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_check_success"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical|space_between">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_check_circle" />
                    <TextView
                        android:text="Images loaded (12)"
                        android:textColor="@color/success"
                        android:textSize="13sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/success" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_check_success"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical|space_between">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_check_circle" />
                    <TextView
                        android:text="Valid timers set"
                        android:textColor="@color/success"
                        android:textSize="13sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/success" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_check_success"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical|space_between">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_check_circle" />
                    <TextView
                        android:text="Notifications enabled"
                        android:textColor="@color/success"
                        android:textSize="13sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/success" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_check_success"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical|space_between">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_check_circle" />
                    <TextView
                        android:text="Overlay permission granted"
                        android:textColor="@color/success"
                        android:textSize="13sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/success" />
            </LinearLayout>

            <!-- Optional -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_check_warning"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical|space_between">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_warning" />
                    <TextView
                        android:text="Device admin (optional)"
                        android:textColor="@color/warning"
                        android:textSize="13sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/warning" />
            </LinearLayout>
        </LinearLayout>

        <!-- This Week (Stats) -->
        <LinearLayout
            android:id="@+id/stats_overview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="vertical">

            <TextView
                android:text="This Week"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_neutral"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_circle_muted"
                            android:padding="10dp"
                            android:src="@drawable/ic_session_pause"
                            android:tint="@color/primary_accent" />

                        <TextView
                            android:id="@+id/tv_focus_time"
                            android:text="8.5h"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:layout_marginTop="6dp" />

                        <TextView
                            android:text="Focus Time"
                            android:textColor="@color/gray_400"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_circle_muted"
                            android:padding="10dp"
                            android:src="@drawable/ic_images"
                            android:tint="@color/secondary_accent" />

                        <TextView
                            android:id="@+id/tv_distractions"
                            android:text="142"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:layout_marginTop="6dp" />

                        <TextView
                            android:text="Distractions Blocked"
                            android:textColor="@color/gray_400"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray_700"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="space_between|center_vertical">

                    <TextView
                        android:text="Weekly Goal Progress"
                        android:textColor="@color/gray_400"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_weekly_goal_percent"
                        android:text="85%"
                        android:textColor="@color/primary_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress_weekly_goal"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:progressDrawable="@drawable/progress_accent"
                    android:max="100"
                    android:progress="85" />
            </LinearLayout>
        </LinearLayout>

        <!-- Recent Activity -->
        <LinearLayout
            android:id="@+id/recent_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="vertical">

            <TextView
                android:text="Recent Activity"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <!-- Item 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_neutral"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_done"
                    android:padding="6dp"
                    android:src="@drawable/ic_check_circle" />

                <LinearLayout
                    android:layout_marginStart="12dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:text="Completed 45min session"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:text="2 hours ago"
                        android:textColor="@color/gray_400"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Item 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_neutral"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_muted"
                    android:padding="6dp"
                    android:src="@drawable/ic_images"
                    android:tint="@color/secondary_accent" />

                <LinearLayout
                    android:layout_marginStart="12dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:text="Added 3 new images"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:text="Yesterday"
                        android:textColor="@color/gray_400"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Item 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_neutral"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_muted"
                    android:padding="6dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/secondary_accent" />

                <LinearLayout
                    android:layout_marginStart="12dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:text="Updated timer settings"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:text="2 days ago"
                        android:textColor="@color/gray_400"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Spacer for bottom nav -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="96dp" />

    </LinearLayout>
</ScrollView>
