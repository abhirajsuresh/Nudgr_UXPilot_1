<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/report_detail_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_screen_gradient">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_muted"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/gray_300"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="SESSION REPORT"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp" />

            <Space
                android:layout_width="40dp"
                android:layout_height="40dp" />
        </LinearLayout>

        <!-- Session Overview -->
        <LinearLayout
            android:id="@+id/session_overview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_card_neutral">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|space_between"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_session_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deep Work Session #47"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_status_completed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="COMPLETED"
                    android:textAllCaps="true"
                    android:textColor="@color/success"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:background="@drawable/bg_check_success" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_session_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="January 15, 2024 • Morning Session"
                android:textColor="@color/gray_400"
                android:textSize="12sp" />

            <!-- Planned vs Actual -->
            <LinearLayout
                android:id="@+id/time_comparison"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_neutral"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:tint="@color/primary_accent"
                            android:src="@drawable/ic_clock" />

                        <TextView
                            android:layout_marginStart="6dp"
                            android:text="PLANNED"
                            android:textColor="@color/gray_400"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_planned_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="45:00"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="22sp" />

                    <TextView
                        android:text="Target Duration"
                        android:textColor="@color/gray_400"
                        android:textSize="11sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_neutral"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:tint="@color/success"
                            android:src="@drawable/ic_check_circle" />

                        <TextView
                            android:layout_marginStart="6dp"
                            android:text="ACTUAL"
                            android:textColor="@color/gray_400"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_actual_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="42:18"
                        android:textColor="@color/success"
                        android:textStyle="bold"
                        android:textSize="22sp" />

                    <TextView
                        android:text="Completed Duration"
                        android:textColor="@color/gray_400"
                        android:textSize="11sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Unlock Timeline -->
        <LinearLayout
            android:id="@+id/session_timeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

            <TextView
                android:text="UNLOCK TIMELINE"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_neutral"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="space_between|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:text="SESSION START"
                        android:textColor="@color/gray_400"
                        android:textSize="12sp" />

                    <TextView
                        android:text="09:15 AM"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Vertical list with a left rule -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:paddingLeft="12dp">

                    <View
                        android:layout_width="2dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:background="@color/gray_700" />

                    <!-- Row 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="space_between|center_vertical"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/dot_active" />

                            <TextView
                                android:layout_marginStart="8dp"
                                android:text="First unlock"
                                android:textColor="@color/gray_300"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:text="09:23 AM"
                            android:textColor="@color/gray_400"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Row 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="space_between|center_vertical"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/dot_inactive" />

                            <TextView
                                android:layout_marginStart="8dp"
                                android:text="Heavy usage period"
                                android:textColor="@color/gray_300"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:text="09:35–09:41 AM"
                            android:textColor="@color/gray_400"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Row 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="space_between|center_vertical"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/dot_inactive" />

                            <TextView
                                android:layout_marginStart="8dp"
                                android:text="Peak distraction"
                                android:textColor="@color/gray_300"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:text="09:48 AM"
                            android:textColor="@color/gray_400"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Row 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="space_between|center_vertical"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/dot_active" />

                            <TextView
                                android:layout_marginStart="8dp"
                                android:text="Focus recovered"
                                android:textColor="@color/gray_300"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:text="09:52 AM"
                            android:textColor="@color/gray_400"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="space_between|center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:text="SESSION END"
                        android:textColor="@color/gray_400"
                        android:textSize="12sp" />

                    <TextView
                        android:text="09:57 AM"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Session Metrics -->
        <LinearLayout
            android:id="@+id/session_metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

            <TextView
                android:text="SESSION METRICS"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="3"
                android:orientation="horizontal">

                <!-- Unlocks -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_neutral"
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_muted"
                        android:padding="8dp"
                        android:src="@drawable/ic_images"
                        android:tint="@color/primary_accent" />

                    <TextView
                        android:text="12"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:text="UNLOCKS"
                        android:textColor="@color/gray_400"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <!-- Reminders -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_neutral"
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_muted"
                        android:padding="8dp"
                        android:src="@drawable/ic_bell"
                        android:tint="@color/secondary_accent" />

                    <TextView
                        android:text="8"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:text="REMINDERS"
                        android:textColor="@color/gray_400"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp" />

                <!-- Snoozes -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_neutral"
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_muted"
                        android:padding="8dp"
                        android:src="@drawable/ic_clock"
                        android:tint="@color/warning" />

                    <TextView
                        android:text="3"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:text="SNOOZES"
                        android:textColor="@color/gray_400"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Lock Actions -->
        <LinearLayout
            android:id="@+id/lock_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_card_neutral"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:text="LOCK ACTIONS"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_done"
                        android:padding="12dp"
                        android:src="@drawable/ic_lock"
                        android:tint="@color/success" />

                    <TextView
                        android:text="5"
                        android:textColor="@color/success"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:text="IMMEDIATE LOCKS"
                        android:textColor="@color/gray_400"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_muted"
                        android:padding="12dp"
                        android:src="@drawable/ic_clock"
                        android:tint="@color/warning" />

                    <TextView
                        android:text="3"
                        android:textColor="@color/warning"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:text="DELAYED LOCKS"
                        android:textColor="@color/gray_400"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@color/gray_700" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="space_between|center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:text="Average lock time"
                    android:textColor="@color/gray_400"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_avg_lock_time"
                    android:text="2.4 seconds"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Images Shown -->
        <LinearLayout
            android:id="@+id/images_used"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

            <TextView
                android:text="IMAGES SHOWN"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_neutral"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Row template repeated manually -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="space_between|center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_muted"
                            android:padding="8dp"
                            android:src="@drawable/ic_images" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:text="motivational_quote_01.jpg"
                                android:textColor="@android:color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:text="Shown 3 times"
                                android:textColor="@color/gray_400"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:text="3x"
                        android:textColor="@color/primary_accent"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray_700" />

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="space_between|center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_muted"
                            android:padding="8dp"
                            android:src="@drawable/ic_images" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:text="nature_calm_02.jpg"
                                android:textColor="@android:color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:text="Shown 2 times"
                                android:textColor="@color/gray_400"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:text="2x"
                        android:textColor="@color/secondary_accent"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray_700" />

                <!-- Row 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="space_between|center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_muted"
                            android:padding="8dp"
                            android:src="@drawable/ic_images" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:text="focus_reminder_03.jpg"
                                android:textColor="@android:color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:text="Shown 2 times"
                                android:textColor="@color/gray_400"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:text="2x"
                        android:textColor="@color/warning"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray_700" />

                <!-- Row 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="space_between|center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_muted"
                            android:padding="8dp"
                            android:src="@drawable/ic_images" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:text="goal_achievement_04.jpg"
                                android:textColor="@android:color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:text="Shown 1 time"
                                android:textColor="@color/gray_400"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:text="1x"
                        android:textColor="@color/gray_400"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Key Insights -->
        <LinearLayout
            android:id="@+id/session_insights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="vertical">

            <TextView
                android:text="KEY INSIGHTS"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <!-- Positive -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_check_success"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="top|start">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_done"
                    android:padding="8dp"
                    android:src="@drawable/ic_check_circle" />

                <LinearLayout
                    android:layout_marginStart="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:text="GREAT PROGRESS"
                        android:textColor="@color/success"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <TextView
                        android:text="You locked your phone immediately 62% of the time - that's a 15% improvement from last week!"
                        android:textColor="@color/gray_300"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="1dp"
                android:layout_height="8dp" />

            <!-- Opportunity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_check_warning"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="top|start">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_muted"
                    android:padding="8dp"
                    android:src="@drawable/ic_warning"
                    android:tint="@color/warning" />

                <LinearLayout
                    android:layout_marginStart="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:text="OPPORTUNITY"
                        android:textColor="@color/warning"
                        android:textStyle="bold"
                        android:textSize="12sp" />

                    <TextView
                        android:text="Peak distraction occurred around 9:48 AM. Consider scheduling breaks around this time."
                        android:textColor="@color/gray_300"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Comparison Stats -->
        <LinearLayout
            android:id="@+id/comparison_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

            <TextView
                android:text="VS PREVIOUS SESSIONS"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_neutral"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="space_between|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:text="Unlocks per session"
                        android:textColor="@color/gray_400"
                        android:textSize="13sp" />

                    <TextView
                        android:text="12  (-3)"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <Space
                    android:layout_width="1dp"
                    android:layout_height="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="space_between|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:text="Session completion rate"
                        android:textColor="@color/gray_400"
                        android:textSize="13sp" />

                    <TextView
                        android:text="94%  (+8%)"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <Space
                    android:layout_width="1dp"
                    android:layout_height="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="space_between|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:text="Average focus streak"
                        android:textColor="@color/gray_400"
                        android:textSize="13sp" />

                    <TextView
                        android:text="8.2 min  (+1.4)"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Actions -->
        <LinearLayout
            android:id="@+id/action_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_start_new_session"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="START NEW SESSION"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:background="@drawable/btn_accent_gradient"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />

            <Space
                android:layout_width="1dp"
                android:layout_height="8dp" />

            <Button
                android:id="@+id/btn_share_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SHARE PROGRESS"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_card_neutral"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
