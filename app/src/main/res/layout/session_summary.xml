<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/session_summary_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="24dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_card_neutral"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/gray_400"
                    android:contentDescription="@string/back" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="SESSION COMPLETE"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <Space
                    android:layout_width="40dp"
                    android:layout_height="40dp" />
            </LinearLayout>

            <!-- Success Indicator -->
            <LinearLayout
                android:id="@+id/success_indicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:layout_marginBottom="12dp">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_circle_done">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="18dp"
                        android:src="@drawable/ic_check"
                        android:tint="@android:color/white" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="GREAT WORK!"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="You've completed another focus session"
                    android:textColor="@color/gray_400"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Session Stats Card -->
            <LinearLayout
                android:id="@+id/session_stats_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_neutral"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Duration Comparison -->
                <LinearLayout
                    android:id="@+id/duration_comparison"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_clock"
                            android:tint="@color/primary_accent" />

                        <TextView
                            android:text="DURATION COMPARISON"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="space_between"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:text="Planned"
                                android:textColor="@color/gray_400"
                                android:textSize="13sp" />

                            <TextView
                                android:text="45:00"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="space_between"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:text="Actual"
                                android:textColor="@color/gray_400"
                                android:textSize="13sp" />

                            <TextView
                                android:text="42:15"
                                android:textColor="@color/success"
                                android:textStyle="bold"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <!-- Percent bar (use your progress_accent for style consistency) -->
                        <ProgressBar
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:progressDrawable="@drawable/progress_accent"
                            android:max="100"
                            android:progress="94" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="6dp"
                            android:text="94% of planned duration"
                            android:textColor="@color/gray_500"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray_700" />

                <!-- SESSION ACTIVITY -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_mobile"
                            android:tint="@color/secondary_accent" />

                        <TextView
                            android:text="SESSION ACTIVITY"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- 2x2 grid -->
                    <LinearLayout
                        android:id="@+id/activity_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginBottom="10dp">

                        <!-- Unlocks -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_neutral"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:text="8"
                                android:textColor="@color/error"
                                android:textStyle="bold"
                                android:textSize="20sp" />

                            <TextView
                                android:text="Phone Unlocks"
                                android:textColor="@color/gray_400"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Reminders -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_neutral"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:text="12"
                                android:textColor="@color/primary_accent"
                                android:textStyle="bold"
                                android:textSize="20sp" />

                            <TextView
                                android:text="Reminders Shown"
                                android:textColor="@color/gray_400"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginBottom="6dp">

                        <!-- Snoozes -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_neutral"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:text="3"
                                android:textColor="@color/warn_yellow"
                                android:textStyle="bold"
                                android:textSize="20sp" />

                            <TextView
                                android:text="Snoozes Used"
                                android:textColor="@color/gray_400"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Locks -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_neutral"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:gravity="center"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:text="9"
                                android:textColor="@color/success"
                                android:textStyle="bold"
                                android:textSize="20sp" />

                            <TextView
                                android:text="Phone Locks"
                                android:textColor="@color/gray_400"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Activity breakdown list -->
                    <LinearLayout
                        android:id="@+id/activity_breakdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="space_between|center_vertical"
                            android:background="@drawable/bg_card_neutral"
                            android:padding="10dp"
                            android:layout_marginBottom="6dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@color/success"
                                    android:layout_marginEnd="8dp" />

                                <TextView
                                    android:text="Immediate locks"
                                    android:textColor="@color/gray_300"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <TextView
                                android:text="5"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="space_between|center_vertical"
                            android:background="@drawable/bg_card_neutral"
                            android:padding="10dp"
                            android:layout_marginBottom="6dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@color/warn_yellow"
                                    android:layout_marginEnd="8dp" />

                                <TextView
                                    android:text="5-minute snoozes"
                                    android:textColor="@color/gray_300"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <TextView
                                android:text="2"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="space_between|center_vertical"
                            android:background="@drawable/bg_card_neutral"
                            android:padding="10dp"
                            android:layout_marginBottom="6dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@color/orange_400"
                                    android:layout_marginEnd="8dp" />

                                <TextView
                                    android:text="10-minute snoozes"
                                    android:textColor="@color/gray_300"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <TextView
                                android:text="1"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="space_between|center_vertical"
                            android:background="@drawable/bg_card_neutral"
                            android:padding="10dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@color/error"
                                    android:layout_marginEnd="8dp" />

                                <TextView
                                    android:text="Reminder dismissals"
                                    android:textColor="@color/gray_300"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <TextView
                                android:text="3"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="13sp" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Insights Card -->
            <LinearLayout
                android:id="@+id/insights_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_neutral"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_lightbulb"
                        android:tint="@color/warn_yellow" />

                    <TextView
                        android:text="QUICK INSIGHTS"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Insight row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_check_circle"
                            android:tint="@color/success" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:text="Strong focus period"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="13sp" />

                            <TextView
                                android:text="You locked your phone immediately 5 times"
                                android:textColor="@color/gray_400"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Insight row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_clock"
                            android:tint="@color/warn_yellow" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:text="Peak distraction time"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="13sp" />

                            <TextView
                                android:text="Most unlocks happened between 2:15-2:30 PM"
                                android:textColor="@color/gray_400"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Insight row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_trend_up"
                            android:tint="@color/secondary_accent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:text="Improvement opportunity"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="13sp" />

                            <TextView
                                android:text="Try shorter reminder intervals for better focus"
                                android:textColor="@color/gray_400"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:id="@+id/action_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_view_full_report"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card_neutral"
                    android:text="VIEW FULL REPORT"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_start_new_session"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/btn_accent_gradient"
                    android:text="START NEW SESSION"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_done"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:text="DONE"
                    android:textAllCaps="false"
                    android:textColor="@color/gray_300"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Session streak -->
            <LinearLayout
                android:id="@+id/session_streak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_neutral"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="space_between|center_vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_muted"
                            android:padding="8dp"
                            android:src="@drawable/ic_fire"
                            android:tint="@color/primary_accent" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:text="7-Day Streak!"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="14sp" />

                            <TextView
                                android:text="Keep it up"
                                android:textColor="@color/gray_400"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:text="7"
                            android:textColor="@color/primary_accent"
                            android:textStyle="bold"
                            android:textSize="20sp" />

                        <TextView
                            android:text="days"
                            android:textColor="@color/gray_400"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Motivational quote -->
            <LinearLayout
                android:id="@+id/motivational_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_neutral"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center_horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_quote_left"
                    android:tint="@color/primary_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="&quot;The successful warrior is the average person with laser-like focus.&quot;"
                    android:textColor="@color/gray_300"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:italic="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="- Bruce Lee"
                    android:textColor="@color/gray_500"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Next session suggestion -->
            <LinearLayout
                android:id="@+id/next_session_suggestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_card_neutral"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_magic"
                        android:tint="@color/secondary_accent" />

                    <TextView
                        android:text="SUGGESTED FOR NEXT SESSION"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="space_between|center_vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:text="Deep Work Duration"
                            android:textColor="@color/gray_300"
                            android:textSize="13sp" />

                        <TextView
                            android:text="Based on your performance"
                            android:textColor="@color/gray_500"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
