<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboard_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <!-- Scrollable content -->
    <ScrollView
        android:id="@+id/scroll_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="96dp">

        <LinearLayout
            android:id="@+id/content_col"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="24dp"
                android:paddingBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Brand -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/btn_accent_gradient"
                        android:scaleType="center"
                        android:padding="6dp"
                        android:src="@drawable/ic_bell"
                        android:tint="@android:color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="NUDGR"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Right icons -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end|center_vertical"
                    android:paddingStart="8dp">

                    <ImageButton
                        android:id="@+id/btn_notifs"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_bell"
                        android:tint="@color/gray_400"
                        android:contentDescription="@string/notifications" />

                    <ImageButton
                        android:id="@+id/btn_settings"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_cog"
                        android:tint="@color/gray_400"
                        android:contentDescription="@string/settings" />
                </LinearLayout>
            </LinearLayout>

            <!-- Session Status Bar -->
            <LinearLayout
                android:id="@+id/session_status_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:padding="12dp"
                android:background="@drawable/bg_card_neutral"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@color/success"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tv_session_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SESSION ACTIVE"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/success" />
            </LinearLayout>

            <!-- Session Running Block -->
            <LinearLayout
                android:id="@+id/session_running_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_neutral"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Task label chip -->
                <LinearLayout
                    android:id="@+id/task_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_accent_gradient"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deep Work Session"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Timer Display (circle placeholder + time) -->
                <FrameLayout
                    android:id="@+id/timer_display"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_circle_muted" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_remaining_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="23:42"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="32sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="REMAINING"
                            android:textColor="@color/gray_400"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Two stats -->
                <LinearLayout
                    android:id="@+id/session_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_neutral"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:id="@+id/tv_unlock_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7"
                            android:textColor="@color/primary_accent"
                            android:textStyle="bold"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phone Unlocks"
                            android:textColor="@color/gray_400"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_neutral"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:id="@+id/tv_reminders_shown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3"
                            android:textColor="@color/secondary_accent"
                            android:textStyle="bold"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reminders Shown"
                            android:textColor="@color/gray_400"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Next reminder -->
                <LinearLayout
                    android:id="@+id/next_reminder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_neutral"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Next reminder in:"
                        android:textColor="@color/gray_300"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_next_reminder_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="02:15"
                        android:textColor="@color/primary_accent"
                        android:textStyle="bold"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="(while unlocked)"
                        android:textColor="@color/gray_400"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Session controls -->
                <LinearLayout
                    android:id="@+id/session_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btn_pause"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PAUSE"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textColor="@color/warning"
                        android:background="@drawable/bg_card_neutral"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btn_end"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="END"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textColor="@color/error"
                        android:background="@drawable/bg_card_neutral"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Today's Progress -->
            <LinearLayout
                android:id="@+id/quick_stats_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <TextView
                    android:text="TODAY'S PROGRESS"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_neutral"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:text="2h 15m"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="18sp" />
                        <TextView
                            android:text="Focused Time"
                            android:textColor="@color/gray_400"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_neutral"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:text="12"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="18sp" />
                        <TextView
                            android:text="Total Unlocks"
                            android:textColor="@color/gray_400"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_neutral"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:text="8"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="18sp" />
                        <TextView
                            android:text="Nudges Shown"
                            android:textColor="@color/gray_400"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Recent Sessions -->
            <LinearLayout
                android:id="@+id/recent_sessions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="space_between|center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:text="RECENT SESSIONS"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btn_view_all_sessions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View All"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_accent"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <!-- Card 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_neutral"
                    android:padding="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_muted"
                            android:padding="8dp"
                            android:src="@drawable/ic_check_circle"
                            android:tint="@color/success" />

                        <LinearLayout
                            android:layout_marginStart="10dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:text="Deep Work"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="13sp" />

                            <TextView
                                android:text="45 min • 3 unlocks"
                                android:textColor="@color/gray_400"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:text="2h ago"
                        android:textColor="@color/gray_400"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Card 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_neutral"
                    android:padding="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_muted"
                            android:padding="8dp"
                            android:src="@drawable/ic_check_circle"
                            android:tint="@color/success" />

                        <LinearLayout
                            android:layout_marginStart="10dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:text="Study Session"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="13sp" />

                            <TextView
                                android:text="30 min • 1 unlock"
                                android:textColor="@color/gray_400"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:text="5h ago"
                        android:textColor="@color/gray_400"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Card 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_neutral"
                    android:padding="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_muted"
                            android:padding="8dp"
                            android:src="@drawable/ic_warning"
                            android:tint="@color/error" />

                        <LinearLayout
                            android:layout_marginStart="10dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:text="Writing Time"
                                android:textColor="@android:color/white"
                                android:textStyle="bold"
                                android:textSize="13sp" />

                            <TextView
                                android:text="15 min • 8 unlocks"
                                android:textColor="@color/gray_400"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:text="Yesterday"
                        android:textColor="@color/gray_400"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Motivational Section -->
            <LinearLayout
                android:id="@+id/motivational_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_neutral"
                android:padding="16dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_muted"
                    android:padding="10dp"
                    android:src="@drawable/ic_trophy"
                    android:tint="@color/primary_accent" />

                <TextView
                    android:layout_marginTop="8dp"
                    android:text="Great Focus Today!"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_marginTop="4dp"
                    android:text="You've reduced distractions by 65% compared to yesterday. Keep it up!"
                    android:textColor="@color/gray_300"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Insights Preview -->
            <LinearLayout
                android:id="@+id/insights_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="24dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="space_between|center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:text="INSIGHTS"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btn_view_insights"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View Details"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_accent"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_neutral"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="space_between|center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:text="Focus Score"
                            android:textColor="@color/gray_400"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_focus_score"
                            android:text="8.2/10"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Progress bar uses your progress_accent drawable -->
                    <ProgressBar
                        style="?android:attr/progressBarStyleHorizontal"
                        android:id="@+id/pb_focus_score"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progressDrawable="@drawable/progress_accent"
                        android:max="100"
                        android:progress="82" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <TextView
                                android:id="@+id/tv_avg_session"
                                android:text="4.2h"
                                android:textColor="@color/primary_accent"
                                android:textStyle="bold"
                                android:textSize="16sp" />

                            <TextView
                                android:text="Avg Session"
                                android:textColor="@color/gray_400"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <TextView
                                android:id="@+id/tv_distraction_rate"
                                android:text="18%"
                                android:textColor="@color/secondary_accent"
                                android:textStyle="bold"
                                android:textSize="16sp" />

                            <TextView
                                android:text="Distraction Rate"
                                android:textColor="@color/gray_400"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation (fixed) -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_card_neutral"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center">

        <!-- Dashboard -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home"
                android:tint="@color/primary_accent" />

            <TextView
                android:text="Dashboard"
                android:textColor="@color/primary_accent"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Start -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_play"
                android:tint="@color/gray_400" />

            <TextView
                android:text="Start"
                android:textColor="@color/gray_400"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Analytics -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chart"
                android:tint="@color/gray_400" />

            <TextView
                android:text="Analytics"
                android:textColor="@color/gray_400"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Gallery -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_images"
                android:tint="@color/gray_400" />

            <TextView
                android:text="Gallery"
                android:textColor="@color/gray_400"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Profile -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_user"
                android:tint="@color/gray_400" />

            <TextView
                android:text="Profile"
                android:textColor="@color/gray_400"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
