<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/image_library_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="@color/gray_300"
            android:background="@drawable/bg_card_neutral" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="IMAGE LIBRARY"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="48dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- Content scroller (everything except bottom bar) -->
    <ScrollView
        android:id="@+id/scroll_container"
        android:layout_below="@id/header"
        android:layout_above="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top actions -->
            <LinearLayout
                android:id="@+id/top_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_add_images"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/btn_accent_gradient"
                        android:text="Add Images"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btn_select_all"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_card_neutral"
                        android:text="Select All"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_delete_selected"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_lock_danger"
                    android:text="Delete"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:enabled="false"
                    android:alpha="0.5"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp" />
            </LinearLayout>

            <!-- Count -->
            <TextView
                android:id="@+id/image_count_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="0 images in your library"
                android:textColor="@color/gray_400"
                android:textSize="14sp" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:background="@drawable/bg_card_blur"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🖼️"
                        android:textSize="28sp"
                        android:textColor="@color/gray_500" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="NO IMAGES YET"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Add motivational images, inspiring quotes, or calming visuals to create your personal nudge library"
                    android:textColor="@color/gray_400"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_add_first_images"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/btn_accent_gradient"
                    android:text="ADD YOUR FIRST IMAGES"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp" />
            </LinearLayout>

            <!-- Grid (hidden until you have images) -->
            <LinearLayout
                android:id="@+id/image_grid_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="24dp"
                android:visibility="gone">

                <!-- Use a GridLayout with 2 columns for simplicity -->
                <GridLayout
                    android:id="@+id/image_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="auto"
                    android:useDefaultMargins="true" />
            </LinearLayout>

            <!-- Tips -->
            <LinearLayout
                android:id="@+id/tips_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_neutral"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:text="TIPS FOR BETTER NUDGES"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_marginTop="6dp"
                    android:text="• Choose images that inspire immediate action\n• Mix quotes with calming visuals\n• Keep your library under 20 images for variety\n• Update regularly to maintain effectiveness"
                    android:textColor="@color/gray_400"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Validation warning (hidden by default) -->
            <LinearLayout
                android:id="@+id/validation_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_neutral"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:text="Minimum Images Required"
                    android:textColor="@color/error"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_marginTop="4dp"
                    android:text="Add at least 1 image to complete setup and start your focus sessions."
                    android:textColor="@color/gray_300"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom nav bar -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:gravity="center_vertical"
        android:background="@color/gray_900"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:text="Images in Library"
                android:textColor="@color/gray_400"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/bottom_count"
                android:layout_marginTop="2dp"
                android:text="0"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="18sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_continue_setup"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/btn_accent_gradient"
            android:text="Continue Setup"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:paddingLeft="20dp"
            android:paddingRight="20dp" />
    </LinearLayout>

</RelativeLayout>
