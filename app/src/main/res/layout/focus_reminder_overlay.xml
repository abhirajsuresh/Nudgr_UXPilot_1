<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_reminder_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_overlay_gradient"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/overlay_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_muted" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="NUDGR"
            android:textSize="12sp"
            android:textColor="@color/gray_400"
            android:fontFamily="@font/inter_bold" />

        <View
            android:layout_width="32dp"
            android:layout_height="32dp" />
    </LinearLayout>

    <!-- Reminder Image -->
    <ImageView
        android:id="@+id/reminder_image"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp"
        android:scaleType="centerCrop"
        android:src="@drawable/sample_motivation"
        android:background="@drawable/bg_card_blur" />

    <!-- Reminder Text -->
    <LinearLayout
        android:id="@+id/reminder_text"
        android:layout_below="@id/reminder_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="24dp">

        <TextView
            android:text="TIME TO REFOCUS"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_bold"
            android:gravity="center" />

        <TextView
            android:text="Take a moment to center yourself and return to what matters most"
            android:textColor="@color/gray_300"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp" />
    </LinearLayout>

    <!-- Stats Box -->
    <LinearLayout
        android:id="@+id/reminder_stats"
        android:layout_below="@id/reminder_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card_blur"
        android:padding="12dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp">

        <TextView
            android:text="12\nUnlocks"
            android:gravity="center"
            android:textColor="@color/primary_accent"
            android:padding="8dp"
            android:textSize="14sp" />

        <TextView
            android:text="05:24\nRemaining"
            android:gravity="center"
            android:textColor="@color/secondary_accent"
            android:padding="8dp"
            android:textSize="14sp" />

        <TextView
            android:text="3\nNudges"
            android:gravity="center"
            android:textColor="@color/primary_accent"
            android:padding="8dp"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:id="@+id/reminder_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btn_lock_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOCK PHONE"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_lock_danger"
            android:fontFamily="@font/inter_bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btn_snooze"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Snooze"
                android:background="@drawable/bg_card_neutral"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btn_extend"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Extend"
                android:background="@drawable/btn_accent_gradient"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
