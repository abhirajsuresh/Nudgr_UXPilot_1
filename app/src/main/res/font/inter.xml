<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Using 24pt variants for standard Android text sizes -->
    <font
        android:fontStyle="normal"
        android:fontWeight="100"
        android:font="@font/inter_24pt_thin" />
    <font
        android:fontStyle="italic"
        android:fontWeight="100"
        android:font="@font/inter_24pt_thinitalic" />

    <font
        android:fontStyle="normal"
        android:fontWeight="200"
        android:font="@font/inter_24pt_extralight" />
    <font
        android:fontStyle="italic"
        android:fontWeight="200"
        android:font="@font/inter_24pt_extralightitalic" />

    <font
        android:fontStyle="normal"
        android:fontWeight="300"
        android:font="@font/inter_24pt_light" />
    <font
        android:fontStyle="italic"
        android:fontWeight="300"
        android:font="@font/inter_24pt_lightitalic" />

    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/inter_24pt_regular" />
    <font
        android:fontStyle="italic"
        android:fontWeight="400"
        android:font="@font/inter_24pt_italic" />

    <font
        android:fontStyle="normal"
        android:fontWeight="500"
        android:font="@font/inter_24pt_medium" />
    <font
        android:fontStyle="italic"
        android:fontWeight="500"
        android:font="@font/inter_24pt_mediumitalic" />

    <font
        android:fontStyle="normal"
        android:fontWeight="600"
        android:font="@font/inter_24pt_semibold" />
    <font
        android:fontStyle="italic"
        android:fontWeight="600"
        android:font="@font/inter_24pt_semibolditalic" />

    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/inter_24pt_bold" />
    <font
        android:fontStyle="italic"
        android:fontWeight="700"
        android:font="@font/inter_24pt_bolditalic" />

    <font
        android:fontStyle="normal"
        android:fontWeight="800"
        android:font="@font/inter_24pt_extrabold" />
    <font
        android:fontStyle="italic"
        android:fontWeight="800"
        android:font="@font/inter_24pt_extrabolditalic" />

    <font
        android:fontStyle="normal"
        android:fontWeight="900"
        android:font="@font/inter_24pt_black" />
    <font
        android:fontStyle="italic"
        android:fontWeight="900"
        android:font="@font/inter_24pt_blackitalic" />
</font-family>
