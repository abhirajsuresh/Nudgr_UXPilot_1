      {
        "id": 16,
        "title": "SessionService Implementation",
        "description": "Create a foreground service that manages deep work sessions with a ticker for tracking time and scheduling nudges.",
        "details": "1. Create `SessionService` class:\n   ```kotlin\n   @AndroidEntryPoint\n   class SessionService : Service() {\n     private val binder = LocalBinder()\n     private var isRunning = false\n     private var durationMs = 0L\n     private var intervalMs = 0L\n     private var startTimeMs = 0L\n     private var elapsedTimeMs = 0L\n     private var tickJob: Job? = null\n     private val serviceScope = CoroutineScope(Dispatchers.Default + SupervisorJob())\n     private var wakeLock: PowerManager.WakeLock? = null\n     \n     inner class LocalBinder : Binder() {\n       fun getService(): SessionService = this@SessionService\n     }\n     \n     override fun onBind(intent: Intent): IBinder = binder\n     \n     override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {\n       when (intent?.action) {\n         ACTION_START -> {\n           durationMs = intent.getLongExtra(EXTRA_DURATION_MS, DEFAULT_DURATION_MS)\n           intervalMs = intent.getLongExtra(EXTRA_INTERVAL_MS, DEFAULT_INTERVAL_MS)\n           startSession()\n         }\n         ACTION_STOP -> stopSession()\n       }\n       return START_STICKY\n     }\n     \n     private fun startSession() {\n       if (isRunning) return\n       \n       startTimeMs = System.currentTimeMillis()\n       isRunning = true\n       \n       // Acquire WakeLock to prevent device sleep during session\n       val powerManager = getSystemService(Context.POWER_SERVICE) as PowerManager\n       wakeLock = powerManager.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, \"Nudgr::SessionWakeLock\")\n       wakeLock?.setReferenceCounted(false)\n       wakeLock?.acquire(durationMs)\n       \n       startForeground(NOTIFICATION_ID, createNotification())\n       \n       tickJob = serviceScope.launch {\n         while (isActive && isRunning) {\n           elapsedTimeMs = System.currentTimeMillis() - startTimeMs\n           \n           // Schedule next nudge if needed\n           if (elapsedTimeMs % intervalMs < TICK_INTERVAL_MS) {\n             scheduleNudge()\n           }\n           \n           // Update notification periodically\n           if (elapsedTimeMs % NOTIFICATION_UPDATE_INTERVAL_MS < TICK_INTERVAL_MS) {\n             updateNotification()\n           }\n           \n           // Check if session is complete\n           if (elapsedTimeMs >= durationMs) {\n             stopSession()\n             break\n           }\n           \n           delay(TICK_INTERVAL_MS)\n         }\n       }\n     }\n     \n     private fun stopSession() {\n       isRunning = false\n       tickJob?.cancel()\n       \n       // Release WakeLock safely\n       if (wakeLock?.isHeld == true) {\n         wakeLock?.release()\n       }\n       wakeLock = null\n       \n       stopForeground(STOP_FOREGROUND_REMOVE)\n       stopSelf()\n       \n       // Broadcast session end\n       sendBroadcast(Intent(ACTION_SESSION_ENDED).apply {\n         putExtra(EXTRA_DURATION_MS, durationMs)\n         putExtra(EXTRA_ELAPSED_MS, elapsedTimeMs)\n       })\n     }\n     \n     private fun scheduleNudge() {\n       val intent = Intent(this, NudgeAlarmReceiver::class.java)\n       val pendingIntent = PendingIntent.getBroadcast(\n         this, 0, intent, PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE\n       )\n       \n       val alarmManager = getSystemService(Context.ALARM_SERVICE) as AlarmManager\n       alarmManager.setExactAndAllowWhileIdle(\n         AlarmManager.RTC_WAKEUP,\n         System.currentTimeMillis() + intervalMs,\n         pendingIntent\n       )\n     }\n     \n     private fun createNotification(): Notification {\n       val notificationIntent = Intent(this, MainActivity::class.java)\n       val pendingIntent = PendingIntent.getActivity(\n         this, 0, notificationIntent, PendingIntent.FLAG_IMMUTABLE\n       )\n       \n       val stopIntent = Intent(this, SessionService::class.java).apply { action = ACTION_STOP }\n       val stopPendingIntent = PendingIntent.getService(\n         this, 0, stopIntent, PendingIntent.FLAG_IMMUTABLE\n       )\n       \n       val notificationChannel = NotificationChannel(\n         CHANNEL_ID,\n         \"Deep Work Session\",\n         NotificationManager.IMPORTANCE_LOW\n       )\n       \n       val notificationManager = getSystemService(NotificationManager::class.java)\n       notificationManager.createNotificationChannel(notificationChannel)\n       \n       return NotificationCompat.Builder(this, CHANNEL_ID)\n         .setContentTitle(\"Deep Work Session\")\n         .setContentText(\"Session in progress\")\n         .setSmallIcon(R.drawable.ic_notification)\n         .setContentIntent(pendingIntent)\n         .addAction(R.drawable.ic_stop, \"End Session\", stopPendingIntent)\n         .build()\n     }\n     \n     private fun updateNotification() {\n       val notificationManager = getSystemService(NotificationManager::class.java)\n       notificationManager.notify(NOTIFICATION_ID, createNotification())\n     }\n     \n     override fun onDestroy() {\n       super.onDestroy()\n       serviceScope.cancel()\n       \n       // Release WakeLock to prevent leaks\n       if (wakeLock?.isHeld == true) {\n         wakeLock?.release()\n       }\n       wakeLock = null\n     }\n     \n     companion object {\n       const val ACTION_START = \"com.nudgr.action.START_SESSION\"\n       const val ACTION_STOP = \"com.nudgr.action.STOP_SESSION\"\n       const val ACTION_SESSION_ENDED = \"com.nudgr.action.SESSION_ENDED\"\n       const val EXTRA_DURATION_MS = \"extra_duration_ms\"\n       const val EXTRA_INTERVAL_MS = \"extra_interval_ms\"\n       const val EXTRA_ELAPSED_MS = \"extra_elapsed_ms\"\n       const val DEFAULT_DURATION_MS = 25 * 60 * 1000L // 25 minutes\n       const val DEFAULT_INTERVAL_MS = 5 * 60 * 1000L // 5 minutes\n       const val TICK_INTERVAL_MS = 250L\n       const val NOTIFICATION_UPDATE_INTERVAL_MS = 15000L // 15 seconds\n       const val NOTIFICATION_ID = 1001\n       const val CHANNEL_ID = \"deep_work_session_channel\"\n     }\n   }\n   ```\n2. Create helper class for starting/stopping the service:\n   ```kotlin\n   object SessionManager {\n     fun startSession(context: Context, durationMs: Long, intervalMs: Long) {\n       val intent = Intent(context, SessionService::class.java).apply {\n         action = SessionService.ACTION_START\n         putExtra(SessionService.EXTRA_DURATION_MS, durationMs)\n         putExtra(SessionService.EXTRA_INTERVAL_MS, intervalMs)\n       }\n       \n       if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {\n         context.startForegroundService(intent)\n       } else {\n         context.startService(intent)\n       }\n     }\n     \n     fun stopSession(context: Context) {\n       val intent = Intent(context, SessionService::class.java).apply {\n         action = SessionService.ACTION_STOP\n       }\n       context.startService(intent)\n     }\n   }\n   ```",
        "testStrategy": "1. Create instrumented tests for service lifecycle\n2. Test service starts and stops correctly\n3. Verify ticker runs at expected intervals\n4. Test nudge scheduling works correctly\n5. Verify service survives when app is in background\n6. Test notification creation and updates\n7. Verify wake lock prevents device sleep during session",
        "priority": "high",
        "dependencies": [
          12,
          13
        ],
        "status": "done",
        "subtasks": []
      },
      {
        "id": 17,
        "title": "NudgeAlarmReceiver & OverlayService",
        "description": "Implement the overlay system that displays nudge images over other apps and handles user interactions with the overlay.",
        "details": "1. Create `NudgeAlarmReceiver`:\n   ```kotlin\n   class NudgeAlarmReceiver : BroadcastReceiver() {\n     override fun onReceive(context: Context, intent: Intent) {\n       val overlayIntent = Intent(context, OverlayService::class.java)\n       if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {\n         context.startForegroundService(overlayIntent)\n       } else {\n         context.startService(overlayIntent)\n       }\n     }\n   }\n   ```\n2. Create `OverlayService`:\n   ```kotlin\n   @AndroidEntryPoint\n   class OverlayService : Service() {\n     private var windowManager: WindowManager? = null\n     private var overlayView: View? = null\n     private val imageRepository: ImageRepository by lazy { ImageRepositoryImpl(this) }\n     \n     override fun onBind(intent: Intent): IBinder? = null\n     \n     override fun onCreate() {\n       super.onCreate()\n       startForeground(NOTIFICATION_ID, createNotification())\n     }\n     \n     override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {\n       if (!Settings.canDrawOverlays(this)) {\n         stopSelf()\n         return START_NOT_STICKY\n       }\n       \n       showOverlay()\n       return START_STICKY\n     }\n     \n     private fun showOverlay() {\n       windowManager = getSystemService(WINDOW_SERVICE) as WindowManager\n       \n       val inflater = getSystemService(LAYOUT_INFLATER_SERVICE) as LayoutInflater\n       overlayView = inflater.inflate(R.layout.overlay_nudge, null)\n       \n       val params = WindowManager.LayoutParams(\n         WindowManager.LayoutParams.MATCH_PARENT,\n         WindowManager.LayoutParams.WRAP_CONTENT,\n         if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY \n         else WindowManager.LayoutParams.TYPE_PHONE,\n         WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or\n             WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,\n         PixelFormat.TRANSLUCENT\n       )\n       \n       params.gravity = Gravity.CENTER\n       \n       // Load random image\n       val reminderImage = overlayView?.findViewById<ImageView>(R.id.reminder_image)\n       loadRandomImage(reminderImage)\n       \n       // Set up buttons\n       overlayView?.findViewById<Button>(R.id.btn_lock_phone)?.setOnClickListener {\n         // Lock phone (placeholder)\n         Toast.makeText(this, \"Lock phone clicked\", Toast.LENGTH_SHORT).show()\n         dismissOverlay()\n       }\n       \n       overlayView?.findViewById<Button>(R.id.btn_snooze)?.setOnClickListener {\n         Toast.makeText(this, \"Nudge snoozed\", Toast.LENGTH_SHORT).show()\n         dismissOverlay()\n       }\n       \n       overlayView?.findViewById<Button>(R.id.btn_extend)?.setOnClickListener {\n         Toast.makeText(this, \"Session extended\", Toast.LENGTH_SHORT).show()\n         dismissOverlay()\n       }\n       \n       windowManager?.addView(overlayView, params)\n     }\n     \n     private fun loadRandomImage(imageView: ImageView?) {\n       imageView ?: return\n       \n       CoroutineScope(Dispatchers.Main).launch {\n         val randomImageUri = imageRepository.getRandomImageUri()\n         if (randomImageUri != null) {\n           imageView.load(randomImageUri) {\n             crossfade(true)\n             placeholder(R.drawable.placeholder_image)\n           }\n         } else {\n           imageView.setImageResource(R.drawable.default_nudge_image)\n         }\n       }\n     }\n     \n     private fun dismissOverlay() {\n       if (overlayView != null && windowManager != null) {\n         windowManager?.removeView(overlayView)\n         overlayView = null\n       }\n       stopSelf()\n     }\n     \n     private fun createNotification(): Notification {\n       val notificationChannel = NotificationChannel(\n         CHANNEL_ID,\n         \"Nudge Overlay\",\n         NotificationManager.IMPORTANCE_LOW\n       )\n       \n       val notificationManager = getSystemService(NotificationManager::class.java)\n       notificationManager.createNotificationChannel(notificationChannel)\n       \n       return NotificationCompat.Builder(this, CHANNEL_ID)\n         .setContentTitle(\"Nudge\")\n         .setContentText(\"Displaying a nudge reminder\")\n         .setSmallIcon(R.drawable.ic_notification)\n         .build()\n     }\n     \n     override fun onDestroy() {\n       dismissOverlay()\n       super.onDestroy()\n     }\n     \n     companion object {\n       const val NOTIFICATION_ID = 1002\n       const val CHANNEL_ID = \"nudge_overlay_channel\"\n     }\n   }\n   ```\n3. Create a permission utility class:\n   ```kotlin\n   object OverlayPermissionHelper {\n     fun canDrawOverlays(context: Context): Boolean {\n       return Settings.canDrawOverlays(context)\n     }\n     \n     fun getOverlayPermissionIntent(context: Context): Intent {\n       return Intent(\n         Settings.ACTION_MANAGE_OVERLAY_PERMISSION,\n         Uri.parse(\"package:${context.packageName}\")\n       )\n     }\n   }\n   ```",
        "testStrategy": "1. Test overlay permission check functionality\n2. Verify overlay appears correctly when triggered\n3. Test all button interactions (snooze, extend, lock)\n4. Verify overlay displays correctly on different Android versions\n5. Test overlay appearance with different image sizes\n6. Verify overlay is properly dismissed when requested\n7. Test service lifecycle (start, stop, destroy)",
        "priority": "high",
        "dependencies": [
          16
        ],
        "status": "done",
        "subtasks": []
      },
      {
        "id": 18,
        "title": "Image Library Implementation",
        "description": "Create the image library functionality to allow users to add, view, select, and delete images for nudges.",
        "details": "1. Create `ImageRepository` interface and implementation:\n   ```kotlin\n   interface ImageRepository {\n     suspend fun getAllImages(): List<ImageItem>\n     suspend fun addImage(uri: Uri): Boolean\n     suspend fun deleteImages(imageIds: List<String>): Boolean\n     suspend fun getRandomImageUri(): Uri?\n     fun getImageCount(): Flow<Int>\n   }\n   \n   @Singleton\n   class ImageRepositoryImpl @Inject constructor(\n     private val context: Context\n   ) : ImageRepository {\n     private val contentResolver = context.contentResolver\n     private val dataStore = context.dataStore\n     private val imagesDir = File(context.filesDir, \"nudge_images\")\n     \n     init {\n       if (!imagesDir.exists()) {\n         imagesDir.mkdirs()\n       }\n     }\n     \n     override suspend fun getAllImages(): List<ImageItem> {\n       return withContext(Dispatchers.IO) {\n         imagesDir.listFiles()?.mapNotNull { file ->\n           try {\n             val uri = Uri.fromFile(file)\n             val metadata = getImageMetadata(file)\n             ImageItem(\n               id = file.nameWithoutExtension,\n               uri = uri,\n               title = metadata.title ?: file.nameWithoutExtension,\n               dateAdded = metadata.dateAdded\n             )\n           } catch (e: Exception) {\n             null\n           }\n         } ?: emptyList()\n       }\n     }\n     \n     override suspend fun addImage(uri: Uri): Boolean {\n       return withContext(Dispatchers.IO) {\n         try {\n           val inputStream = contentResolver.openInputStream(uri) ?: return@withContext false\n           val fileName = \"image_${System.currentTimeMillis()}.jpg\"\n           val outputFile = File(imagesDir, fileName)\n           \n           outputFile.outputStream().use { outputStream ->\n             inputStream.copyTo(outputStream)\n           }\n           \n           // Update image count in DataStore\n           updateImageCount()\n           \n           true\n         } catch (e: Exception) {\n           false\n         }\n       }\n     }\n     \n     override suspend fun deleteImages(imageIds: List<String>): Boolean {\n       return withContext(Dispatchers.IO) {\n         var success = true\n         imageIds.forEach { id ->\n           val file = File(imagesDir, \"$id.jpg\")\n           if (file.exists() && !file.delete()) {\n             success = false\n           }\n         }\n         \n         // Update image count in DataStore\n         updateImageCount()\n         \n         success\n       }\n     }\n     \n     override suspend fun getRandomImageUri(): Uri? {\n       return withContext(Dispatchers.IO) {\n         imagesDir.listFiles()?.randomOrNull()?.let { Uri.fromFile(it) }\n       }\n     }\n     \n     override fun getImageCount(): Flow<Int> {\n       return dataStore.data.map { preferences ->\n         preferences[PreferencesKeys.IMAGE_COUNT] ?: 0\n       }\n     }\n     \n     private suspend fun updateImageCount() {\n       val count = imagesDir.listFiles()?.size ?: 0\n       dataStore.edit { preferences ->\n         preferences[PreferencesKeys.IMAGE_COUNT] = count\n         preferences[PreferencesKeys.HAS_IMAGES] = count > 0\n       }\n     }\n     \n     private fun getImageMetadata(file: File): ImageMetadata {\n       return ImageMetadata(\n         title = file.nameWithoutExtension,\n         dateAdded = file.lastModified()\n       )\n     }\n   }\n   \n   data class ImageItem(\n     val id: String,\n     val uri: Uri,\n     val title: String,\n     val dateAdded: Long,\n     var isSelected: Boolean = false\n   )\n   \n   data class ImageMetadata(\n     val title: String?,\n     val dateAdded: Long\n   )\n   ```\n2. Create `ImageLibraryFragment`:\n   ```kotlin\n   @AndroidEntryPoint\n   class ImageLibraryFragment : BaseFragment<FragmentImageLibraryBinding>() {\n     private val viewModel: ImageLibraryViewModel by viewModels()\n     private lateinit var adapter: ImageAdapter\n     \n     override fun getViewBinding(inflater: LayoutInflater, container: ViewGroup?): FragmentImageLibraryBinding {\n       return FragmentImageLibraryBinding.inflate(inflater, container, false)\n     }\n     \n     override fun onViewCreated(view: View, savedInstanceState: Bundle?) {\n       super.onViewCreated(view, savedInstanceState)\n       \n       setupRecyclerView()\n       setupButtons()\n       observeViewModel()\n     }\n     \n     private fun setupRecyclerView() {\n       adapter = ImageAdapter { imageItem, isSelected ->\n         viewModel.toggleImageSelection(imageItem.id, isSelected)\n       }\n       \n       binding.imageGrid.apply {\n         layoutManager = GridLayoutManager(requireContext(), 3)\n         adapter = this@ImageLibraryFragment.adapter\n       }\n     }\n     \n     private fun setupButtons() {\n       binding.btnAddImages.setOnClickListener {\n         openImagePicker()\n       }\n       \n       binding.btnAddFirstImages.setOnClickListener {\n         openImagePicker()\n       }\n       \n       binding.btnSelectAll.setOnClickListener {\n         viewModel.toggleSelectAll()\n       }\n       \n       binding.btnDeleteSelected.setOnClickListener {\n         viewModel.deleteSelectedImages()\n       }\n     }\n     \n     private fun observeViewModel() {\n       viewLifecycleOwner.lifecycleScope.launch {\n         viewModel.images.collect { images ->\n           adapter.submitList(images)\n           updateUiState(images.isEmpty())\n           binding.imageCountInfo.text = \"${images.size} images\"\n           binding.bottomCount.text = \"${viewModel.selectedCount.value} selected\"\n         }\n       }\n       \n       viewLifecycleOwner.lifecycleScope.launch {\n         viewModel.selectedCount.collect { count ->\n           binding.bottomCount.text = \"$count selected\"\n           binding.btnDeleteSelected.isEnabled = count > 0\n         }\n       }\n     }\n     \n     private fun updateUiState(isEmpty: Boolean) {\n       binding.emptyState.isVisible = isEmpty\n       binding.imageGridContainer.isVisible = !isEmpty\n       binding.btnAddFirstImages.isVisible = isEmpty\n       binding.btnAddImages.isVisible = !isEmpty\n       binding.btnSelectAll.isVisible = !isEmpty\n       binding.btnDeleteSelected.isVisible = !isEmpty\n     }\n     \n     private fun openImagePicker() {\n       val intent = Intent(Intent.ACTION_OPEN_DOCUMENT).apply {\n         addCategory(Intent.CATEGORY_OPENABLE)\n         type = \"image/*\"\n         putExtra(Intent.EXTRA_ALLOW_MULTIPLE, true)\n       }\n       startActivityForResult(intent, REQUEST_IMAGE_PICK)\n     }\n     \n     override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {\n       super.onActivityResult(requestCode, resultCode, data)\n       \n       if (requestCode == REQUEST_IMAGE_PICK && resultCode == Activity.RESULT_OK) {\n         data?.let { intent ->\n           val clipData = intent.clipData\n           if (clipData != null) {\n             for (i in 0 until clipData.itemCount) {\n               val uri = clipData.getItemAt(i).uri\n               viewModel.addImage(uri)\n             }\n           } else {\n             intent.data?.let { uri ->\n               viewModel.addImage(uri)\n             }\n           }\n         }\n       }\n     }\n     \n     companion object {\n       private const val REQUEST_IMAGE_PICK = 1001\n     }\n   }\n   ```\n3. Create `ImageLibraryViewModel`:\n   ```kotlin\n   @HiltViewModel\n   class ImageLibraryViewModel @Inject constructor(\n     private val imageRepository: ImageRepository\n   ) : ViewModel() {\n     private val _images = MutableStateFlow<List<ImageItem>>(emptyList())\n     val images: StateFlow<List<ImageItem>> = _images\n     \n     private val _selectedCount = MutableStateFlow(0)\n     val selectedCount: StateFlow<Int> = _selectedCount\n     \n     init {\n       loadImages()\n     }\n     \n     private fun loadImages() {\n       viewModelScope.launch {\n         _images.value = imageRepository.getAllImages()\n       }\n     }\n     \n     fun addImage(uri: Uri) {\n       viewModelScope.launch {\n         val success = imageRepository.addImage(uri)\n         if (success) {\n           loadImages()\n         }\n       }\n     }\n     \n     fun toggleImageSelection(imageId: String, isSelected: Boolean) {\n       _images.value = _images.value.map { item ->\n         if (item.id == imageId) {\n           item.copy(isSelected = isSelected)\n         } else {\n           item\n         }\n       }\n       \n       _selectedCount.value = _images.value.count { it.isSelected }\n     }\n     \n     fun toggleSelectAll() {\n       val allSelected = _images.value.all { it.isSelected }\n       _images.value = _images.value.map { it.copy(isSelected = !allSelected) }\n       _selectedCount.value = if (allSelected) 0 else _images.value.size\n     }\n     \n     fun deleteSelectedImages() {\n       val selectedIds = _images.value.filter { it.isSelected }.map { it.id }\n       \n       viewModelScope.launch {\n         val success = imageRepository.deleteImages(selectedIds)\n         if (success) {\n           loadImages()\n         }\n       }\n     }\n   }\n   ```\n4. Create `ImageAdapter` for the RecyclerView",
        "testStrategy": "1. Test image repository CRUD operations\n2. Verify image selection and deselection in the adapter\n3. Test the select all and delete selected functionality\n4. Verify UI state changes correctly between empty and populated states\n5. Test image picker integration\n6. Verify image count updates correctly\n7. Test random image selection for nudges\n8. Verify persistence of images across app restarts",
        "priority": "medium",
        "dependencies": [
          14,
          15
        ],
        "status": "done",
        "subtasks": []
      },
      {
        "id": 19,
        "title": "Dashboard & Timer Setup Implementation",
        "description": "Create the dashboard and timer setup screens to allow users to configure and start deep work sessions.",
        "details": "1. Create `TimerSetupFragment`:\n   ```kotlin\n   @AndroidEntryPoint\n   class TimerSetupFragment : BaseFragment<FragmentTimerSetupBinding>() {\n     private val viewModel: TimerSetupViewModel by viewModels()\n     \n     override fun getViewBinding(inflater: LayoutInflater, container: ViewGroup?): FragmentTimerSetupBinding {\n       return FragmentTimerSetupBinding.inflate(inflater, container, false)\n     }\n     \n     override fun onViewCreated(view: View, savedInstanceState: Bundle?) {\n       super.onViewCreated(view, savedInstanceState)\n       \n       loadSavedValues()\n       setupListeners()\n     }\n     \n     private fun loadSavedValues() {\n       viewLifecycleOwner.lifecycleScope.launch {\n         viewModel.durationMinutes.collect { minutes ->\n           binding.inputDuration.setText(minutes.toString())\n         }\n       }\n       \n       viewLifecycleOwner.lifecycleScope.launch {\n         viewModel.intervalMinutes.collect { minutes ->\n           binding.inputInterval.setText(minutes.toString())\n         }\n       }\n     }\n     \n     private fun setupListeners() {\n       binding.btnStartSession.setOnClickListener {\n         val durationText = binding.inputDuration.text.toString()\n         val intervalText = binding.inputInterval.text.toString()\n         \n         if (durationText.isBlank() || intervalText.isBlank()) {\n           Toast.makeText(requireContext(), \"Please enter valid values\", Toast.LENGTH_SHORT).show()\n           return@setOnClickListener\n         }\n         \n         val durationMinutes = durationText.toIntOrNull() ?: 25\n         val intervalMinutes = intervalText.toIntOrNull() ?: 5\n         \n         if (durationMinutes <= 0 || intervalMinutes <= 0) {\n           Toast.makeText(requireContext(), \"Values must be greater than 0\", Toast.LENGTH_SHORT).show()\n           return@setOnClickListener\n         }\n         \n         if (intervalMinutes >= durationMinutes) {\n           Toast.makeText(requireContext(), \"Interval must be less than duration\", Toast.LENGTH_SHORT).show()\n           return@setOnClickListener\n         }\n         \n         viewModel.saveDurationAndInterval(durationMinutes, intervalMinutes)\n         \n         findNavController().navigate(R.id.action_timerSetup_to_dashboard)\n       }\n     }\n   }\n   ```\n2. Create `TimerSetupViewModel`:\n   ```kotlin\n   @HiltViewModel\n   class TimerSetupViewModel @Inject constructor(\n     private val settingsRepository: SettingsRepository\n   ) : ViewModel() {\n     val durationMinutes: StateFlow<Int> = settingsRepository.durationMs\n       .map { it / (60 * 1000) }\n       .stateIn(viewModelScope, SharingStarted.Eagerly, 25)\n     \n     val intervalMinutes: StateFlow<Int> = settingsRepository.intervalMs\n       .map { it / (60 * 1000) }\n       .stateIn(viewModelScope, SharingStarted.Eagerly, 5)\n     \n     fun saveDurationAndInterval(durationMinutes: Int, intervalMinutes: Int) {\n       viewModelScope.launch {\n         settingsRepository.setDurationMs(durationMinutes * 60 * 1000L)\n         settingsRepository.setIntervalMs(intervalMinutes * 60 * 1000L)\n       }\n     }\n   }\n   ```\n3. Create `DashboardFragment`:\n   ```kotlin\n   @AndroidEntryPoint\n   class DashboardFragment : BaseFragment<FragmentDashboardBinding>() {\n     private val viewModel: DashboardViewModel by viewModels()\n     private var sessionActive = false\n     \n     override fun getViewBinding(inflater: LayoutInflater, container: ViewGroup?): FragmentDashboardBinding {\n       return FragmentDashboardBinding.inflate(inflater, container, false)\n     }\n     \n     override fun onViewCreated(view: View, savedInstanceState: Bundle?) {\n       super.onViewCreated(view, savedInstanceState)\n       \n       setupButtons()\n       observeViewModel()\n       registerSessionEndReceiver()\n     }\n     \n     private fun setupButtons() {\n       binding.btnStart.setOnClickListener {\n         viewModel.startSession(requireContext())\n         updateUiForActiveSession(true)\n       }\n       \n       binding.btnPauseResume.setOnClickListener {\n         // Pause/resume functionality can be added in future versions\n         Toast.makeText(requireContext(), \"Pause/Resume not implemented in MVP\", Toast.LENGTH_SHORT).show()\n       }\n       \n       binding.btnEnd.setOnClickListener {\n         viewModel.endSession(requireContext())\n         updateUiForActiveSession(false)\n       }\n     }\n     \n     private fun observeViewModel() {\n       viewLifecycleOwner.lifecycleScope.launch {\n         viewModel.sessionSettings.collect { settings ->\n           binding.tvIntervalValue.text = \"${settings.intervalMinutes} min\"\n           binding.tvImagesValue.text = \"${settings.imageCount} images\"\n         }\n       }\n       \n       viewLifecycleOwner.lifecycleScope.launch {\n         viewModel.lastSessionStats.collect { stats ->\n           binding.lastDuration.text = \"${stats.durationMinutes} min\"\n           binding.lastUnlocks.text = \"${stats.unlockCount}\"\n           binding.lastNudges.text = \"${stats.nudgeCount}\"\n         }\n       }\n     }\n     \n     private fun updateUiForActiveSession(active: Boolean) {\n       sessionActive = active\n       binding.btnStart.isVisible = !active\n       binding.btnPauseResume.isVisible = active\n       binding.btnEnd.isVisible = active\n     }\n     \n     private fun registerSessionEndReceiver() {\n       val filter = IntentFilter(SessionService.ACTION_SESSION_ENDED)\n       requireActivity().registerReceiver(sessionEndReceiver, filter)\n     }\n     \n     private val sessionEndReceiver = object : BroadcastReceiver() {\n       override fun onReceive(context: Context, intent: Intent) {\n         if (intent.action == SessionService.ACTION_SESSION_ENDED) {\n           updateUiForActiveSession(false)\n           findNavController().navigate(R.id.action_dashboard_to_summary)\n         }\n       }\n     }\n     \n     override fun onDestroyView() {\n       requireActivity().unregisterReceiver(sessionEndReceiver)\n       super.onDestroyView()\n     }\n   }\n   ```\n4. Create `DashboardViewModel`:\n   ```kotlin\n   @HiltViewModel\n   class DashboardViewModel @Inject constructor(\n     private val settingsRepository: SettingsRepository,\n     private val sessionRepository: SessionRepository\n   ) : ViewModel() {\n     data class SessionSettings(\n       val durationMinutes: Int,\n       val intervalMinutes: Int,\n       val imageCount: Int\n     )\n     \n     data class SessionStats(\n       val durationMinutes: Int,\n       val nudgeCount: Int,\n       val unlockCount: Int\n     )\n     \n     private val _sessionSettings = MutableStateFlow(SessionSettings(25, 5, 0))\n     val sessionSettings: StateFlow<SessionSettings> = _sessionSettings\n     \n     private val _lastSessionStats = MutableStateFlow(SessionStats(0, 0, 0))\n     val lastSessionStats: StateFlow<SessionStats> = _lastSessionStats\n     \n     init {\n       loadSettings()\n       loadLastSessionStats()\n     }\n     \n     private fun loadSettings() {\n       viewModelScope.launch {\n         combine(\n           settingsRepository.durationMs,\n           settingsRepository.intervalMs,\n           settingsRepository.imageCount\n         ) { durationMs, intervalMs, imageCount ->\n           SessionSettings(\n             durationMinutes = (durationMs / (60 * 1000)).toInt(),\n             intervalMinutes = (intervalMs / (60 * 1000)).toInt(),\n             imageCount = imageCount\n           )\n         }.collect {\n           _sessionSettings.value = it\n         }\n       }\n     }\n     \n     private fun loadLastSessionStats() {\n       viewModelScope.launch {\n         sessionRepository.getLastSessionStats().collect { stats ->\n           _lastSessionStats.value = SessionStats(\n             durationMinutes = stats.durationMinutes,\n             nudgeCount = stats.nudgeCount,\n             unlockCount = stats.unlockCount\n           )\n         }\n       }\n     }\n     \n     fun startSession(context: Context) {\n       viewModelScope.launch {\n         val durationMs = settingsRepository.durationMs.first()\n         val intervalMs = settingsRepository.intervalMs.first()\n         \n         SessionManager.startSession(context, durationMs, intervalMs)\n         \n         // Log analytics event\n         FirebaseAnalytics.getInstance(context).logEvent(\"session_start\", Bundle().apply {\n           putLong(\"duration_ms\", durationMs)\n           putLong(\"interval_ms\", intervalMs)\n         })\n       }\n     }\n     \n     fun endSession(context: Context) {\n       SessionManager.stopSession(context)\n     }\n   }\n   ```",
        "testStrategy": "1. Test timer setup input validation\n2. Verify settings are saved correctly to DataStore\n3. Test dashboard UI updates based on session state\n4. Verify session start/end functionality\n5. Test broadcast receiver for session end events\n6. Verify navigation between timer setup and dashboard\n7. Test session statistics display\n8. Verify analytics events are logged correctly",
        "priority": "medium",
        "dependencies": [
          14,
          15,
          16
        ],
        "status": "done",
        "subtasks": []
      },
      {
        "id": 20,
        "title": "Session Logging & Summary Screen",
        "description": "Implement session logging and create a summary screen to display session statistics to the user.",
        "details": "1. Create `SessionLog` data class and repository:\n   ```kotlin\n   data class SessionLog(\n     val id: String = UUID.randomUUID().toString(),\n     val startTime: Long,\n     val endTime: Long,\n     val durationMs: Long,\n     val nudgeCount: Int,\n     val unlockCount: Int\n   )\n   \n   interface SessionRepository {\n     suspend fun saveSession(sessionLog: SessionLog)\n     fun getAllSessions(): Flow<List<SessionLog>>\n     fun getLastSessionStats(): Flow<SessionStats>\n     fun getSessionStats(timeRangeMs: Long): Flow<SessionStats>\n   }\n   \n   data class SessionStats(\n     val durationMinutes: Int,\n     val nudgeCount: Int,\n     val unlockCount: Int,\n     val sessionCount: Int\n   )\n   \n   @Singleton\n   class SessionRepositoryImpl @Inject constructor(\n     private val context: Context\n   ) : SessionRepository {\n     private val sessionLogsFile = File(context.filesDir, \"session_logs.json\")\n     private val gson = Gson()\n     private val sessionsFlow = MutableStateFlow<List<SessionLog>>(emptyList())\n     \n     init {\n       loadSessions()\n     }\n     \n     private fun loadSessions() {\n       if (!sessionLogsFile.exists()) {\n         sessionsFlow.value = emptyList()\n         return\n       }\n       \n       try {\n         val json = sessionLogsFile.readText()\n         val type = object : TypeToken<List<SessionLog>>() {}.type\n         val sessions = gson.fromJson<List<SessionLog>>(json, type) ?: emptyList()\n         sessionsFlow.value = sessions\n       } catch (e: Exception) {\n         sessionsFlow.value = emptyList()\n       }\n     }\n     \n     override suspend fun saveSession(sessionLog: SessionLog) {\n       withContext(Dispatchers.IO) {\n         val currentSessions = sessionsFlow.value.toMutableList()\n         currentSessions.add(sessionLog)\n         sessionsFlow.value = currentSessions\n         \n         try {\n           val json = gson.toJson(currentSessions)\n           sessionLogsFile.writeText(json)\n         } catch (e: Exception) {\n           // Log error\n         }\n       }\n     }\n     \n     override fun getAllSessions(): Flow<List<SessionLog>> = sessionsFlow\n     \n     override fun getLastSessionStats(): Flow<SessionStats> {\n       return sessionsFlow.map { sessions ->\n         val lastSession = sessions.maxByOrNull { it.endTime }\n         \n         if (lastSession != null) {\n           SessionStats(\n             durationMinutes = (lastSession.durationMs / (60 * 1000)).toInt(),\n             nudgeCount = lastSession.nudgeCount,\n             unlockCount = lastSession.unlockCount,\n             sessionCount = 1\n           )\n         } else {\n           SessionStats(0, 0, 0, 0)\n         }\n       }\n     }\n     \n     override fun getSessionStats(timeRangeMs: Long): Flow<SessionStats> {\n       return sessionsFlow.map { sessions ->\n         val cutoffTime = System.currentTimeMillis() - timeRangeMs\n         val filteredSessions = sessions.filter { it.endTime >= cutoffTime }\n         \n         SessionStats(\n           durationMinutes = filteredSessions.sumOf { (it.durationMs / (60 * 1000)).toInt() },\n           nudgeCount = filteredSessions.sumOf { it.nudgeCount },\n           unlockCount = filteredSessions.sumOf { it.unlockCount },\n           sessionCount = filteredSessions.size\n         )\n       }\n     }\n   }\n   ```\n2. Create `SummaryFragment`:\n   ```kotlin\n   @AndroidEntryPoint\n   class SummaryFragment : BaseFragment<FragmentSummaryBinding>() {\n     private val viewModel: SummaryViewModel by viewModels()\n     \n     override fun getViewBinding(inflater: LayoutInflater, container: ViewGroup?): FragmentSummaryBinding {\n       return FragmentSummaryBinding.inflate(inflater, container, false)\n     }\n     \n     override fun onViewCreated(view: View, savedInstanceState: Bundle?) {\n       super.onViewCreated(view, savedInstanceState)\n       \n       observeViewModel()\n       setupButtons()\n     }\n     \n     private fun observeViewModel() {\n       viewLifecycleOwner.lifecycleScope.launch {\n         viewModel.lastSessionStats.collect { stats ->\n           binding.lastSessionDuration.text = \"${stats.durationMinutes} minutes\"\n           binding.lastSessionNudges.text = \"${stats.nudgeCount} nudges\"\n           binding.lastSessionUnlocks.text = \"${stats.unlockCount} unlocks\"\n         }\n       }\n       \n       viewLifecycleOwner.lifecycleScope.launch {\n         viewModel.weeklyStats.collect { stats ->\n           binding.weeklySessionCount.text = \"${stats.sessionCount} sessions\"\n           binding.weeklyTotalDuration.text = \"${stats.durationMinutes} minutes\"\n           binding.weeklyTotalNudges.text = \"${stats.nudgeCount} nudges\"\n         }\n       }\n     }\n     \n     private fun setupButtons() {\n       binding.btnBackToDashboard.setOnClickListener {\n         findNavController().navigate(R.id.action_summary_to_dashboard)\n       }\n       \n       binding.btnNewSession.setOnClickListener {\n         findNavController().navigate(R.id.action_summary_to_timerSetup)\n       }\n     }\n   }\n   ```\n3. Create `SummaryViewModel`:\n   ```kotlin\n   @HiltViewModel\n   class SummaryViewModel @Inject constructor(\n     private val sessionRepository: SessionRepository\n   ) : ViewModel() {\n     val lastSessionStats: StateFlow<SessionStats> = sessionRepository.getLastSessionStats()\n       .stateIn(viewModelScope, SharingStarted.Eagerly, SessionStats(0, 0, 0, 0))\n     \n     val weeklyStats: StateFlow<SessionStats> = sessionRepository.getSessionStats(7 * 24 * 60 * 60 * 1000L)\n       .stateIn(viewModelScope, SharingStarted.Eagerly, SessionStats(0, 0, 0, 0))\n   }\n   ```\n4. Update `SessionService` to log sessions:\n   ```kotlin\n   // In SessionService.kt\n   @Inject\n   lateinit var sessionRepository: SessionRepository\n   \n   private var nudgeCount = 0\n   private var unlockCount = 0\n   \n   // In scheduleNudge() method\n   nudgeCount++\n   \n   // Add method to track unlocks\n   fun incrementUnlockCount() {\n     unlockCount++\n   }\n   \n   // In stopSession() method\n   viewModelScope.launch {\n     sessionRepository.saveSession(\n       SessionLog(\n         startTime = startTimeMs,\n         endTime = System.currentTimeMillis(),\n         durationMs = elapsedTimeMs,\n         nudgeCount = nudgeCount,\n         unlockCount = unlockCount\n       )\n     )\n   }\n   ```",
        "testStrategy": "1. Test session repository save and retrieve operations\n2. Verify session statistics calculations\n3. Test summary screen UI updates with session data\n4. Verify navigation from summary to dashboard and timer setup\n5. Test session logging during active sessions\n6. Verify persistence of session logs across app restarts\n7. Test weekly statistics aggregation\n8. Verify JSON serialization and deserialization of session logs",
        "priority": "medium",
        "dependencies": [
          16,
          19
        ],
        "status": "done",
        "subtasks": []
      },
      {
        "id": 21,
        "title": "Firebase Integration & Analytics",
        "description": "Implement Firebase integration for analytics, crashlytics, and optional user authentication.",
        "details": "1. Create `FirebaseAnalyticsHelper`:\n   ```kotlin\n   @Singleton\n   class FirebaseAnalyticsHelper @Inject constructor(\n     private val context: Context\n   ) {\n     private val firebaseAnalytics = FirebaseAnalytics.getInstance(context)\n     \n     fun logOnboardingStepComplete(step: String) {\n       firebaseAnalytics.logEvent(\"onboarding_step_complete\", Bundle().apply {\n         putString(\"step_name\", step)\n       })\n     }\n     \n     fun logSessionStart(durationMs: Long, intervalMs: Long) {\n       firebaseAnalytics.logEvent(\"session_start\", Bundle().apply {\n         putLong(\"duration_ms\", durationMs)\n         putLong(\"interval_ms\", intervalMs)\n       })\n     }\n     \n     fun logNudgeShown() {\n       firebaseAnalytics.logEvent(\"nudge_shown\", null)\n     }\n     \n     fun logSessionComplete(durationMs: Long, nudgeCount: Int, unlockCount: Int) {\n       firebaseAnalytics.logEvent(\"session_complete\", Bundle().apply {\n         putLong(\"duration_ms\", durationMs)\n         putInt(\"nudge_count\", nudgeCount)\n         putInt(\"unlock_count\", unlockCount)\n       })\n     }\n   }\n   ```\n2. Create `FirebaseAuthHelper` for optional sign-in:\n   ```kotlin\n   @Singleton\n   class FirebaseAuthHelper @Inject constructor(\n     private val context: Context\n   ) {\n     private val auth = FirebaseAuth.getInstance()\n     private val _currentUser = MutableStateFlow<FirebaseUser?>(auth.currentUser)\n     val currentUser: StateFlow<FirebaseUser?> = _currentUser\n     \n     init {\n       auth.addAuthStateListener { firebaseAuth ->\n         _currentUser.value = firebaseAuth.currentUser\n       }\n     }\n     \n     fun isSignedIn(): Boolean {\n       return auth.currentUser != null\n     }\n     \n     fun signInWithGoogle(activity: Activity, requestCode: Int) {\n       val gso = GoogleSignInOptions.Builder(GoogleSignInOptions.DEFAULT_SIGN_IN)\n         .requestIdToken(context.getString(R.string.default_web_client_id))\n         .requestEmail()\n         .build()\n       \n       val googleSignInClient = GoogleSignIn.getClient(activity, gso)\n       val signInIntent = googleSignInClient.signInIntent\n       activity.startActivityForResult(signInIntent, requestCode)\n     }\n     \n     fun handleSignInResult(data: Intent?, onSuccess: () -> Unit, onError: (Exception) -> Unit) {\n       try {\n         val task = GoogleSignIn.getSignedInAccountFromIntent(data)\n         val account = task.getResult(ApiException::class.java)\n         firebaseAuthWithGoogle(account.idToken!!, onSuccess, onError)\n       } catch (e: Exception) {\n         onError(e)\n       }\n     }\n     \n     private fun firebaseAuthWithGoogle(idToken: String, onSuccess: () -> Unit, onError: (Exception) -> Unit) {\n       val credential = GoogleAuthProvider.getCredential(idToken, null)\n       auth.signInWithCredential(credential)\n         .addOnCompleteListener { task ->\n           if (task.isSuccessful) {\n             onSuccess()\n           } else {\n             onError(task.exception ?: Exception(\"Unknown error\"))\n           }\n         }\n     }\n     \n     fun signOut() {\n       auth.signOut()\n     }\n   }\n   ```\n3. Create `FirestoreSyncManager` for optional cloud sync:\n   ```kotlin\n   @Singleton\n   class FirestoreSyncManager @Inject constructor(\n     private val firebaseAuthHelper: FirebaseAuthHelper,\n     private val settingsRepository: SettingsRepository,\n     private val sessionRepository: SessionRepository\n   ) {\n     private val db = FirebaseFirestore.getInstance()\n     private val scope = CoroutineScope(Dispatchers.IO + SupervisorJob())\n     \n     init {\n       scope.launch {\n         firebaseAuthHelper.currentUser.collect { user ->\n           if (user != null) {\n             syncSettings(user.uid)\n             syncSessions(user.uid)\n           }\n         }\n       }\n     }\n     \n     private suspend fun syncSettings(userId: String) {\n       val userSettingsRef = db.collection(\"users\").document(userId).collection(\"settings\").document(\"app_settings\")\n       \n       // Listen for local changes and push to Firestore\n       scope.launch {\n         combine(\n           settingsRepository.durationMs,\n           settingsRepository.intervalMs,\n           settingsRepository.hasImages,\n           settingsRepository.hasPermissions\n         ) { durationMs, intervalMs, hasImages, hasPermissions ->\n           mapOf(\n             \"durationMs\" to durationMs,\n             \"intervalMs\" to intervalMs,\n             \"hasImages\" to hasImages,\n             \"hasPermissions\" to hasPermissions,\n             \"lastUpdated\" to FieldValue.serverTimestamp()\n           )\n         }.collect { settings ->\n           try {\n             userSettingsRef.set(settings, SetOptions.merge())\n           } catch (e: Exception) {\n             // Log error\n           }\n         }\n       }\n       \n       // Listen for remote changes and pull to local\n       userSettingsRef.addSnapshotListener { snapshot, error ->\n         if (error != null || snapshot == null || !snapshot.exists()) {\n           return@addSnapshotListener\n         }\n         \n         scope.launch {\n           snapshot.getLong(\"durationMs\")?.let { settingsRepository.setDurationMs(it) }\n           snapshot.getLong(\"intervalMs\")?.let { settingsRepository.setIntervalMs(it) }\n         }\n       }\n     }\n     \n     private suspend fun syncSessions(userId: String) {\n       val userSessionsRef = db.collection(\"users\").document(userId).collection(\"sessions\")\n       \n       // Listen for local changes and push to Firestore\n       scope.launch {\n         sessionRepository.getAllSessions().collect { sessions ->\n           sessions.forEach { session ->\n             try {\n               userSessionsRef.document(session.id).set(session)\n             } catch (e: Exception) {\n               // Log error\n             }\n           }\n         }\n       }\n     }\n   }\n   ```\n4. Update `NudgrApplication` to initialize Firebase:\n   ```kotlin\n   @HiltAndroidApp\n   class NudgrApplication : Application() {\n     override fun onCreate() {\n       super.onCreate()\n       \n       // Initialize Firebase\n       FirebaseApp.initializeApp(this)\n       \n       // Initialize Crashlytics\n       FirebaseCrashlytics.getInstance().setCrashlyticsCollectionEnabled(true)\n     }\n   }\n   ```\n5. Add analytics calls to key user actions in fragments and services",
        "testStrategy": "1. Verify Firebase initialization in the application class\n2. Test analytics event logging for key user actions\n3. Verify Crashlytics is properly initialized\n4. Test Google Sign-In flow\n5. Verify Firestore sync works when user is signed in\n6. Test offline functionality when user is not signed in\n7. Verify data consistency between local storage and Firestore\n8. Test auth state changes (sign in, sign out)",
